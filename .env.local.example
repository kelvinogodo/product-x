# --- Supabase (Project Settings -> API) ---------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Database scripts only: `pnpm db:migrate` / `pnpm db:seed` (not used by the running app) -------
# Use the "Session pooler" or "Transaction pooler" string (Project Settings -> Database -> Connection
# string). The direct host (db.<ref>.supabase.co) is IPv6-only and fails on IPv4-only networks.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres

# --- Site URL --------------------------------------------------------------------------------------
# Used for password-reset / confirmation links, the sitemap, and social-preview images.
# Set this explicitly in production (e.g. https://yourapp.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (optional) ------------------------------------------------------------------------------
# Transactional email via Resend (https://resend.com). Without these, emails are skipped and the app
# works as normal. Used for: resource-request receipts, admin notifications, certificate emails.
# RESEND_API_KEY=re_...
# EMAIL_FROM="product x <hello@yourdomain.com>"
# ADMIN_NOTIFY_EMAIL=you@yourdomain.com
