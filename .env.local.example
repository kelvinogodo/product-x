# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional — only needed to run `pnpm db:push` / `pnpm db:seed` (Project Settings -> Database -> Connection string)
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Optional — used to build password-reset email links. Falls back to the request host if unset,
# but set this explicitly in production (e.g. https://yourapp.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
